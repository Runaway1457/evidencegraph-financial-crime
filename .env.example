EG_ENVIRONMENT=development
EG_LOG_LEVEL=INFO
EG_API_PREFIX=/api/v1
EG_CORS_ORIGINS=["http://localhost:5173"]
EG_AUTH_MODE=development
# Production: signed_jwt plus a secret supplied by your secret manager.
# EG_AUTH_MODE=signed_jwt
# EG_JWT_SECRET=replace-with-at-least-32-random-bytes
EG_JWT_ISSUER=evidencegraph
EG_JWT_AUDIENCE=evidencegraph-api
EG_DATABASE_URL=sqlite+pysqlite:///./evidencegraph.db
EG_OBJECT_STORE_PATH=./var/evidence-objects
EG_MAX_UPLOAD_BYTES=26214400
EG_OUTBOX_LEASE_SECONDS=30
EG_OUTBOX_MAX_ATTEMPTS=10
EG_OUTBOX_POLL_SECONDS=1.0
